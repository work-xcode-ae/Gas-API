// =====================================================================
// Sedra Petrol - Buildings & Utilities Management + Accounting
// Schema v2.3 (party master, assets, documents, inventory, sales/purchase, vouchers, customer requests)
//   |  Target: PostgreSQL
// Paste into https://dbdiagram.io to render the ER diagram.
//
// CONVENTIONS (apply to EVERY table, omitted below for readability):
//   created_at timestamptz not null default now()
//   created_by bigint  -> app_user.id
//   updated_at timestamptz
//   updated_by bigint  -> app_user.id
//   is_deleted boolean not null default false
// All *_status_id / *_type_id columns -> lookup_value.id (see LOOKUP_TYPE codes in notes)
// Money: decimal(14,2). Quantities: decimal(14,3). Rates: decimal(18,6).
// =====================================================================

Project sedra_petrol {
  database_type: 'PostgreSQL'
  Note: 'v2.3 - source of truth for the DB. Regenerate the diagram from this file; do not edit images.'
}

// ---------------------------------------------------------------------
// 1. ORGANIZATION & LOCATION
// ---------------------------------------------------------------------
Table company {
  id bigint [pk, increment]
  code varchar(20) [unique, not null]
  name_en varchar(200) [not null]
  name_ar varchar(200) [not null]
  address text
  trn varchar(20) [note: 'UAE VAT Tax Registration Number']
  phone varchar(30)
  email varchar(150)
  website varchar(150)
  base_currency_id bigint [ref: > currency.id]
  is_active boolean [default: true]
  Note: 'v2.3: logo, dark logo and stamp are documents (COMPANY_LOGO, COMPANY_LOGO_DARK, COMPANY_STAMP) on entity_type=company.'
}

Table country {
  id bigint [pk, increment]
  code char(2) [unique, not null]
  name_en varchar(100)
  name_ar varchar(100)
  is_active boolean [default: true]
}

Table emirate {
  id bigint [pk, increment]
  country_id bigint [ref: > country.id, not null]
  code varchar(10) [unique]
  name_en varchar(100)
  name_ar varchar(100)
}

Table city {
  id bigint [pk, increment]
  emirate_id bigint [ref: > emirate.id, not null]
  code varchar(20) [unique]
  name_en varchar(100)
  name_ar varchar(100)
  latitude decimal(9,6)
  longitude decimal(9,6)
  is_active boolean [default: true]
}

Table branch {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  city_id bigint [ref: > city.id]
  code varchar(20) [unique, not null]
  name_en varchar(200)
  name_ar varchar(200)
  address text
  phone varchar(30)
  email varchar(150)
  is_active boolean [default: true]
}

// ---------------------------------------------------------------------
// 2. LOOKUPS
// ---------------------------------------------------------------------
Table lookup_type {
  id bigint [pk, increment]
  code varchar(50) [unique, not null, note: 'BUILDING_TYPE, BUILDING_STATUS, UNIT_TYPE, UNIT_STATUS, METER_TYPE, METER_STATUS, METER_SERVICE_TYPE, READING_METHOD, CONTRACT_STATUS, FEE_TYPE, FEE_CYCLE, INVOICE_TYPE, INVOICE_STATUS, PAYMENT_METHOD, PAYMENT_STATUS, PARTY_TYPE, CONTACT_TYPE, VENDOR_TYPE, DOCUMENT_CATEGORY, DOCUMENT_STATUS, TANK_STATUS, REFILL_STAGE, REFILL_STATUS, PRIORITY, SR_STATUS, VISIT_TYPE, VISIT_STATUS, VISIT_FREQUENCY, SEVERITY, AMC_TERM_TYPE, SCOPE_ITEM_TYPE, CD_CERT_TYPE, CD_STATUS, ACCOUNT_TYPE, TANK_EVENT_TYPE, NATIONALITY, DEPARTMENT, DESIGNATION, EMPLOYMENT_STATUS, ASSET_CATEGORY, ASSET_STATUS, DEPRECIATION_METHOD, ITEM_TYPE, ITEM_CATEGORY, UOM, STOCK_TXN_TYPE, STOCK_TXN_STATUS, STOCK_REASON, QUOTATION_STATUS, SO_STATUS, PO_STATUS, DN_DIRECTION, DN_STATUS, MR_STATUS, VOUCHER_TYPE, VOUCHER_STATUS, CUSTOMER_REQUEST_TYPE, CUSTOMER_REQUEST_STATUS, REQUEST_CHANNEL, REQUEST_REASON, NEXT_ACTION, APPROVAL_DECISION']
  name_en varchar(100)
  name_ar varchar(100)
  description text
  is_active boolean [default: true]
}

Table lookup_value {
  id bigint [pk, increment]
  lookup_type_id bigint [ref: > lookup_type.id, not null]
  code varchar(50) [not null]
  name_en varchar(150)
  name_ar varchar(150)
  parent_id bigint [ref: > lookup_value.id]
  sort_order int [default: 0]
  is_active boolean [default: true]
  indexes { (lookup_type_id, code) [unique] }
}

// ---------------------------------------------------------------------
// 3. PARTIES, VENDORS & TRANSPORT
// ---------------------------------------------------------------------
Table party {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id]
  party_code varchar(30) [unique, note: 'P-000123 (number_sequence prefix P)']
  party_type_id bigint [ref: > lookup_value.id, not null, note: 'PARTY_TYPE: company | individual | employee | supplier | customer | stock | repository']
  parent_party_id bigint [ref: > party.id, note: 'e.g. stock/repository -> owning company; supplier employee -> supplier']
  is_internal boolean [default: false, note: 'true = our own company, our employees, our stores']
  name_en varchar(200)
  name_ar varchar(200)
  emirates_id varchar(20) [note: 'individual / employee - number only; the scan + expiry is a document (EID)']
  nationality_id bigint [ref: > lookup_value.id]
  trade_license_no varchar(50) [note: 'company / supplier - number only; scan + expiry is a document (TRADE_LICENSE)']
  tax_number varchar(30)
  phone varchar(30)
  email varchar(150)
  city_id bigint [ref: > city.id]
  po_box varchar(20)
  address text
  is_active boolean [default: true]
  Note: 'MASTER of every person / organisation / holding location. Extensions: party_employee (employee details), vendor (supplier details), tenant (customer details), party_store (stock / repository). Documents (EID, passport, licence...) live in document with party_id.'
}

Table party_employee {
  id bigint [pk, increment]
  party_id bigint [ref: - party.id, unique, not null, note: 'party_type = employee']
  employee_no varchar(30) [unique, not null]
  employer_party_id bigint [ref: > party.id, note: 'null = our company; supplier party = supplier staff (e.g. supplier tanker driver)']
  branch_id bigint [ref: > branch.id]
  department_id bigint [ref: > lookup_value.id, note: 'DEPARTMENT']
  designation_id bigint [ref: > lookup_value.id, not null, note: 'DESIGNATION: DRIVER | TECHNICIAN | ENGINEER | STOREKEEPER | ACCOUNTANT | SALES | SUPERVISOR | MANAGER | ...']
  manager_party_id bigint [ref: > party.id]
  app_user_id bigint [ref: > app_user.id, note: 'set if the employee logs in to the portal']
  date_of_birth date
  join_date date
  end_date date
  employment_status_id bigint [ref: > lookup_value.id, note: 'active | on_leave | resigned | terminated']
  mobile varchar(30)
  work_email varchar(150)
  Note: 'Replaces the v2.2 driver table: a driver is an employee with designation DRIVER. Driving licence and hazmat permit are documents with expiry + reminders.'
}

Table party_store {
  id bigint [pk, increment]
  party_id bigint [ref: - party.id, unique, not null, note: 'party_type = stock | repository']
  branch_id bigint [ref: > branch.id, not null]
  building_id bigint [ref: > building.id, note: 'if the store sits in one of our buildings']
  keeper_party_id bigint [ref: > party.id, note: 'employee responsible (storekeeper)']
  allow_negative_stock boolean [default: false]
  is_active boolean [default: true]
}

Table party_contact {
  id bigint [pk, increment]
  party_id bigint [ref: > party.id, not null]
  contact_type_id bigint [ref: > lookup_value.id, not null, note: 'phone | email']
  value varchar(150) [not null]
  is_default boolean [default: false]
  is_active boolean [default: true]
}

Table party_bank_account {
  id bigint [pk, increment]
  party_id bigint [ref: > party.id, not null]
  bank_name varchar(150)
  account_name varchar(150)
  iban varchar(34)
  is_default boolean [default: false]
  is_active boolean [default: true]
}

Table vendor {
  id bigint [pk, increment]
  party_id bigint [ref: - party.id, unique, not null, note: 'supplier details extension of party (party_type = supplier)']
  branch_id bigint [ref: > branch.id]
  vendor_type_id bigint [ref: > lookup_value.id, not null, note: 'GAS_SUPPLIER | MAINTENANCE_VENDOR | SERVICE_VENDOR | OTHER']
  code varchar(30) [unique]
  name_en varchar(200)
  name_ar varchar(200)
  trade_license_no varchar(50)
  trn varchar(20)
  phone varchar(30)
  email varchar(150)
  address text
  payable_account_id bigint [ref: > account.id]
  payment_terms_days smallint
  is_active boolean [default: true]
  Note: 'v2.3: name/licence/trn are kept for backward compatibility; party is the master. Trade licence & VAT certificate files are documents on the party.'
}

Table vendor_contact {
  id bigint [pk, increment]
  vendor_id bigint [ref: > vendor.id, not null]
  name_en varchar(150)
  name_ar varchar(150)
  position varchar(100) [note: 'e.g. Engineer / Technician']
  phone varchar(30)
  email varchar(150)
  is_default boolean [default: false]
  is_active boolean [default: true]
}

Table vehicle {
  id bigint [pk, increment]
  asset_id bigint [ref: - asset.id, unique, note: 'required for our own vehicles; null only for supplier tankers']
  vendor_id bigint [ref: > vendor.id, note: 'null = own company vehicle']
  vehicle_type_id bigint [ref: > lookup_value.id, note: 'ASSET_CATEGORY child: tanker | pickup | car | van']
  default_driver_party_id bigint [ref: > party.id, note: 'employee with designation DRIVER']
  plate_no varchar(20) [unique, not null]
  plate_source varchar(30) [note: 'Dubai, Abu Dhabi, Sharjah ...']
  make varchar(50)
  model varchar(50)
  model_year smallint
  chassis_no varchar(50)
  capacity_litres decimal(14,3)
  is_active boolean [default: true]
  Note: 'Registration (Mulkiya), insurance and permits are documents on the asset (asset_id) with expiry + reminders.'
}

// ---------------------------------------------------------------------
// 4. USERS & SECURITY
// ---------------------------------------------------------------------
Table app_user {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id, note: 'home branch']
  name_en varchar(150)
  name_ar varchar(150)
  email varchar(150) [unique, not null]
  phone varchar(30)
  password_hash varchar(255)
  last_login_at timestamptz
  is_active boolean [default: true]
}

Table role {
  id bigint [pk, increment]
  code varchar(50) [unique, not null]
  name_en varchar(100)
  name_ar varchar(100)
}

Table permission {
  id bigint [pk, increment]
  code varchar(100) [unique, not null, note: 'e.g. buildings.create, invoices.post']
  module varchar(50)
  name_en varchar(150)
  name_ar varchar(150)
  is_active boolean [default: true]
}

Table user_role {
  user_id bigint [ref: > app_user.id]
  role_id bigint [ref: > role.id]
  indexes { (user_id, role_id) [pk] }
}

Table role_permission {
  role_id bigint [ref: > role.id]
  permission_id bigint [ref: > permission.id]
  indexes { (role_id, permission_id) [pk] }
}

Table user_branch {
  user_id bigint [ref: > app_user.id]
  branch_id bigint [ref: > branch.id]
  indexes { (user_id, branch_id) [pk] }
}

// ---------------------------------------------------------------------
// 5. BUILDINGS & UNITS
// ---------------------------------------------------------------------
Table building {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  code varchar(20) [unique, not null, note: 'B-001']
  name_en varchar(200)
  name_ar varchar(200)
  building_type_id bigint [ref: > lookup_value.id, note: 'residential | commercial | mixed']
  status_id bigint [ref: > lookup_value.id, note: 'active | inactive']
  city_id bigint [ref: > city.id]
  zone varchar(100)
  street varchar(150)
  po_box varchar(20)
  address text
  latitude decimal(9,6)
  longitude decimal(9,6)
  total_floors int
  notes text
  is_active boolean [default: true]
}

Table building_owner {
  id bigint [pk, increment]
  building_id bigint [ref: > building.id, not null]
  party_id bigint [ref: > party.id, not null]
  ownership_percentage decimal(5,2)
  is_primary boolean [default: false]
  from_date date
  to_date date
}

Table unit {
  id bigint [pk, increment]
  building_id bigint [ref: > building.id, not null]
  unit_no varchar(20) [not null]
  floor_no int
  unit_type_id bigint [ref: > lookup_value.id, note: 'apartment | penthouse | studio | duplex | villa | commercial']
  area_sqm decimal(10,2)
  bedrooms smallint
  bathrooms smallint
  rent_amount decimal(14,2) [note: 'informational only']
  status_id bigint [ref: > lookup_value.id, note: 'vacant | occupied | reserved | maintenance']
  last_inspection_date date
  notes text
  is_active boolean [default: true]
  indexes { (building_id, unit_no) [unique] }
}

// ---------------------------------------------------------------------
// 6. TENANTS & SUPPLY CONTRACTS
// ---------------------------------------------------------------------
Table tenant {
  id bigint [pk, increment]
  party_id bigint [ref: - party.id, unique, not null, note: 'customer details extension of party (party_type = customer / individual / company)']
  branch_id bigint [ref: > branch.id, not null]
  tenant_code varchar(20) [unique, not null]
  name_en varchar(200)
  name_ar varchar(200)
  emirates_id varchar(20) [unique]
  nationality_id bigint [ref: > lookup_value.id]
  date_of_birth date
  phone varchar(30)
  email varchar(150)
  city_id bigint [ref: > city.id]
  address text
  receivable_account_id bigint [ref: > account.id]
  is_active boolean [default: true]
}

Table supply_contract {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  contract_no varchar(30) [unique, not null, note: 'single numbering scheme: GSC-YYYY-NNNN']
  tenant_id bigint [ref: > tenant.id, not null]
  unit_id bigint [ref: > unit.id, not null]
  meter_id bigint [ref: > meter.id]
  start_date date [not null]
  end_date date
  auto_renew boolean [default: false]
  renewal_period_months smallint
  deposit_amount decimal(14,2)
  deposit_paid boolean [default: false]
  deposit_date date
  terms text
  status_id bigint [ref: > lookup_value.id, note: 'draft | active | pending | expired | terminated']
  terminated_at date
  is_active boolean [default: true]
  Note: 'Partial unique index: one ACTIVE contract per unit.'
}

Table contract_fee {
  id bigint [pk, increment]
  contract_id bigint [ref: > supply_contract.id, not null]
  fee_type_id bigint [ref: > lookup_value.id, not null, note: 'gas_price | maintenance | connection | disconnection | inspection | meter_rent | insurance | other']
  cycle_id bigint [ref: > lookup_value.id, not null, note: 'monthly | yearly | one_time | per_m3']
  amount decimal(14,4) [not null]
  currency_id bigint [ref: > currency.id]
  effective_from date [not null]
  effective_to date
  notes text
  is_active boolean [default: true]
}

// ---------------------------------------------------------------------
// 7. METER MANAGEMENT
// ---------------------------------------------------------------------
Table meter {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  asset_id bigint [ref: - asset.id, unique, note: 'company-owned meter as an asset']
  meter_no varchar(20) [unique, not null]
  serial_no varchar(50) [unique, not null]
  meter_type_id bigint [ref: > lookup_value.id, note: 'smart | standard | prepaid']
  brand varchar(50)
  model varchar(50)
  sim_card_no varchar(30)
  calibration_date date
  install_date date
  initial_reading decimal(14,3) [default: 0]
  location_note varchar(200)
  status_id bigint [ref: > lookup_value.id, note: 'active | fault | disconnected | maintenance']
  is_active boolean [default: true]
}

Table meter_assignment {
  id bigint [pk, increment]
  meter_id bigint [ref: > meter.id, not null]
  unit_id bigint [ref: > unit.id, not null]
  from_date date [not null]
  to_date date [note: 'null = current. Partial unique: one open row per meter and per unit']
}

Table meter_reading {
  id bigint [pk, increment]
  meter_id bigint [ref: > meter.id, not null]
  reading_date timestamptz [not null]
  reading_value decimal(14,3) [not null, note: 'cumulative m3']
  consumption decimal(14,3) [note: 'value - previous value']
  method_id bigint [ref: > lookup_value.id, note: 'manual | remote | customer | photo']
  read_by bigint [ref: > app_user.id]
  invoice_id bigint [ref: > invoice.id, note: 'set when billed; prevents double billing']
  notes text
  indexes { (meter_id, reading_date) }
}

Table meter_service {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  service_no varchar(30) [unique]
  meter_id bigint [ref: > meter.id, not null]
  contract_id bigint [ref: > supply_contract.id]
  service_type_id bigint [ref: > lookup_value.id, not null, note: 'connect | disconnect | replace | report_issue']
  issue_type_id bigint [ref: > lookup_value.id]
  priority_id bigint [ref: > lookup_value.id]
  reason text
  requested_date date
  completed_date date
  before_reading decimal(14,3)
  after_reading decimal(14,3)
  new_meter_id bigint [ref: > meter.id, note: 'for replace']
  safety_check_passed boolean
  tenant_notified boolean
  technician_id bigint [ref: > app_user.id]
  fee_invoice_item_id bigint [ref: > invoice_item.id]
  status_id bigint [ref: > lookup_value.id]
}

Table meter_topup {
  id bigint [pk, increment]
  meter_id bigint [ref: > meter.id, not null]
  topup_date timestamptz [not null]
  amount decimal(14,2) [not null]
  quantity_m3 decimal(14,3)
  payment_id bigint [ref: > payment.id]
}

// ---------------------------------------------------------------------
// 8. TANKS & REFILL WORKFLOW
// ---------------------------------------------------------------------
Table gas_type {
  id bigint [pk, increment]
  code varchar(20) [unique, not null, note: 'LPG | NG']
  name_en varchar(100)
  name_ar varchar(100)
  litre_to_m3 decimal(18,6) [not null, note: 'conversion factor for billing']
  is_active boolean [default: true]
}

Table tank {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  building_id bigint [ref: > building.id, not null]
  asset_id bigint [ref: - asset.id, unique, note: 'company-owned tank as an asset']
  tank_no varchar(20) [not null]
  gas_type_id bigint [ref: > gas_type.id, not null]
  capacity_litres decimal(14,3) [not null]
  current_level_litres decimal(14,3) [note: 'cache of latest tank_level_history']
  serial_no varchar(50)
  manufacturer varchar(100)
  install_date date
  last_inspection_date date
  next_inspection_date date
  status_id bigint [ref: > lookup_value.id, note: 'ok | low | maintenance | out_of_service']
  is_active boolean [default: true]
  indexes { (building_id, tank_no) [unique] }
}

Table tank_level_history {
  id bigint [pk, increment]
  tank_id bigint [ref: > tank.id, not null]
  event_date timestamptz [not null]
  event_type_id bigint [ref: > lookup_value.id, note: 'refill | manual_reading | sensor | adjustment']
  level_litres decimal(14,3) [not null]
  tank_refill_id bigint [ref: > tank_refill.id]
  notes text
}

Table refill_request {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  request_no varchar(30) [unique, not null, note: 'RFR-YYYY-NNNN']
  tank_id bigint [ref: > tank.id, not null]
  request_date date [not null]
  requested_by bigint [ref: > app_user.id]
  requested_qty_litres decimal(14,3) [not null]
  level_at_request_litres decimal(14,3)
  priority_id bigint [ref: > lookup_value.id]
  current_stage_id bigint [ref: > lookup_value.id, note: 'REFILL_STAGE 0..8']
  status_id bigint [ref: > lookup_value.id, note: 'requested | po_issued | paid | collecting | invoiced | scheduled | delivering | pending_approval | completed | cancelled']
  approved_by bigint [ref: > app_user.id, note: 'stage 7']
  approved_at timestamptz
  approval_notes text
  completed_at timestamptz
  notes text
}

Table refill_stage_history {
  id bigint [pk, increment]
  refill_request_id bigint [ref: > refill_request.id, not null]
  from_stage_id bigint [ref: > lookup_value.id]
  to_stage_id bigint [ref: > lookup_value.id, not null]
  changed_by bigint [ref: > app_user.id]
  changed_at timestamptz [not null]
  remarks text
}

// Stage 1 - Purchase order
Table refill_po {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  vendor_id bigint [ref: > vendor.id, not null]
  po_number varchar(30) [unique, not null]
  po_date date [not null]
  qty_litres decimal(14,3)
  unit_price decimal(14,4)
  total_amount decimal(14,2)
  currency_id bigint [ref: > currency.id]
}

// Stage 2 - Supplier payment (money lives in vendor_payment)
Table refill_supplier_payment {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  vendor_payment_id bigint [ref: > vendor_payment.id, not null]
}

// Stage 3 - Collection at supplier
Table refill_collection {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  vehicle_id bigint [ref: > vehicle.id]
  driver_party_id bigint [ref: > party.id, note: 'employee, designation DRIVER']
  collection_date timestamptz
  meter_before decimal(14,3)
  meter_after decimal(14,3)
  collected_qty_litres decimal(14,3)
}

// Stage 4 - Purchase invoice (money lives in vendor_bill)
Table refill_purchase_invoice {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  vendor_bill_id bigint [ref: > vendor_bill.id, not null]
}

// Stage 5 - Delivery schedule + Civil Defense confirmation
Table refill_schedule {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  delivery_date date [not null]
  time_slot varchar(30)
  civil_defense_confirmed boolean [default: false]
  civil_defense_ref varchar(50)
}

// Stage 6 - Actual tank refill
Table tank_refill {
  id bigint [pk, increment]
  refill_request_id bigint [ref: - refill_request.id, unique, not null]
  tank_id bigint [ref: > tank.id, not null]
  refill_datetime timestamptz [not null]
  vehicle_id bigint [ref: > vehicle.id]
  driver_party_id bigint [ref: > party.id, note: 'employee, designation DRIVER']
  level_before_litres decimal(14,3)
  level_after_litres decimal(14,3)
  delivered_qty_litres decimal(14,3)
  safety_check_passed boolean
  notes text
}

// ---------------------------------------------------------------------
// 9. AMC MAINTENANCE CONTRACTS
// ---------------------------------------------------------------------
Table amc_contract {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  contract_no varchar(30) [unique, not null]
  vendor_id bigint [ref: > vendor.id, not null]
  building_id bigint [ref: > building.id, not null]
  owner_party_id bigint [ref: > party.id, note: 'signing owner']
  start_date date [not null]
  end_date date [not null]
  annual_value decimal(14,2)
  currency_id bigint [ref: > currency.id]
  visit_frequency_id bigint [ref: > lookup_value.id, note: 'monthly | quarterly | semi_annual | annual']
  visits_total smallint
  response_time_hours smallint
  emergency_included boolean [default: false]
  status_id bigint [ref: > lookup_value.id, note: 'pending | active | expired']
  notes text
  is_active boolean [default: true]
}

Table amc_scope_item {
  id bigint [pk, increment]
  contract_id bigint [ref: > amc_contract.id, not null]
  item_type_id bigint [ref: > lookup_value.id, not null, note: 'included | excluded']
  description text [not null]
}

Table amc_term {
  id bigint [pk, increment]
  contract_id bigint [ref: > amc_contract.id, not null]
  term_type_id bigint [ref: > lookup_value.id, note: 'category']
  description text [not null]
  is_custom boolean [default: false]
}

Table amc_payment_schedule {
  id bigint [pk, increment]
  contract_id bigint [ref: > amc_contract.id, not null]
  label varchar(100)
  due_date date [not null]
  amount decimal(14,2) [not null]
  status_id bigint [ref: > lookup_value.id, note: 'pending | billed | paid']
  vendor_bill_id bigint [ref: > vendor_bill.id]
  notes text
}

// ---------------------------------------------------------------------
// 10. MAINTENANCE VISITS
// ---------------------------------------------------------------------
Table checklist_template {
  id bigint [pk, increment]
  visit_type_id bigint [ref: > lookup_value.id]
  name_en varchar(150)
  name_ar varchar(150)
  is_active boolean [default: true]
}

Table checklist_template_item {
  id bigint [pk, increment]
  template_id bigint [ref: > checklist_template.id, not null]
  item_text_en varchar(300)
  item_text_ar varchar(300)
  sort_order int
}

Table maintenance_visit {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  visit_no varchar(30) [unique]
  amc_contract_id bigint [ref: > amc_contract.id, not null]
  building_id bigint [ref: > building.id, not null]
  visit_type_id bigint [ref: > lookup_value.id]
  period_label varchar(20) [note: 'Q4 2026']
  scheduled_date date [not null]
  time_slot varchar(30)
  visit_date date
  vendor_contact_id bigint [ref: > vendor_contact.id, note: 'technician']
  technician_phone varchar(30)
  status_id bigint [ref: > lookup_value.id, note: 'scheduled | in_progress | completed | cancelled']
  report_summary text
  completed_at timestamptz
  notes text
}

Table visit_checklist_item {
  id bigint [pk, increment]
  visit_id bigint [ref: > maintenance_visit.id, not null]
  template_item_id bigint [ref: > checklist_template_item.id]
  item_text varchar(300) [not null, note: 'copied from template, editable']
  sort_order int
  is_done boolean [default: false]
  notes text
}

Table visit_finding {
  id bigint [pk, increment]
  visit_id bigint [ref: > maintenance_visit.id, not null]
  severity_id bigint [ref: > lookup_value.id]
  description text [not null]
  action_taken text
  service_request_id bigint [ref: > service_request.id]
}

// ---------------------------------------------------------------------
// 11. SERVICE REQUESTS
// ---------------------------------------------------------------------
Table service_request {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  request_no varchar(30) [unique, not null, note: 'SR-YYYY-NNNN']
  building_id bigint [ref: > building.id, not null]
  unit_id bigint [ref: > unit.id]
  tenant_id bigint [ref: > tenant.id]
  meter_id bigint [ref: > meter.id]
  description text [not null]
  priority_id bigint [ref: > lookup_value.id, note: 'low | medium | high']
  status_id bigint [ref: > lookup_value.id, note: 'pending | in_progress | completed']
  assigned_to bigint [ref: > app_user.id]
  assigned_vendor_id bigint [ref: > vendor.id]
  requested_at timestamptz
  closed_at timestamptz
  notes text
}

// ---------------------------------------------------------------------
// 12. CIVIL DEFENSE COMPLIANCE
// ---------------------------------------------------------------------
Table cd_certificate {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  building_id bigint [ref: > building.id, not null]
  certificate_no varchar(50) [unique]
  cert_type_id bigint [ref: > lookup_value.id]
  license_no varchar(50)
  issued_by varchar(150)
  issue_date date
  expiry_date date
  scope text
  inspector_name varchar(150)
  inspection_date date
  status_id bigint [ref: > lookup_value.id, note: 'valid | expired | renewal_in_progress']
  notes text
}

Table cd_renewal {
  id bigint [pk, increment]
  certificate_id bigint [ref: > cd_certificate.id, not null]
  started_at date
  current_step smallint
  inspector_name varchar(150)
  inspector_phone varchar(30)
  inspector_dept varchar(150)
  renewal_date date
  new_expiry_date date
  new_certificate_id bigint [ref: > cd_certificate.id]
  status_id bigint [ref: > lookup_value.id]
  remarks text
}

// ---------------------------------------------------------------------
// 13. BILLING & PAYMENTS - TENANTS (AR)
// ---------------------------------------------------------------------
Table invoice {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  invoice_no varchar(30) [unique, not null]
  customer_party_id bigint [ref: > party.id, not null, note: 'v2.3: any customer party']
  tenant_id bigint [ref: > tenant.id, note: 'v2.3: optional - set for gas-supply invoices']
  sales_order_id bigint [ref: > sales_order.id]
  delivery_note_id bigint [ref: > delivery_note.id]
  building_id bigint [ref: > building.id]
  contract_id bigint [ref: > supply_contract.id]
  invoice_type_id bigint [ref: > lookup_value.id, note: 'gas_consumption | maintenance | deposit | connection | other']
  billing_period_start date
  billing_period_end date
  issue_date date [not null]
  due_date date [not null]
  subtotal decimal(14,2)
  vat_amount decimal(14,2) [default: 0]
  total_amount decimal(14,2)
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  status_id bigint [ref: > lookup_value.id, note: 'draft | pending | partial | paid | overdue | cancelled']
  journal_entry_id bigint [ref: > journal_entry.id]
  notes text
}

Table invoice_item {
  id bigint [pk, increment]
  invoice_id bigint [ref: > invoice.id, not null]
  item_type_id bigint [ref: > lookup_value.id, note: 'FEE_TYPE']
  description varchar(300)
  quantity decimal(14,3)
  uom varchar(10) [note: 'm3 | month | each']
  unit_price decimal(14,4)
  vat_rate decimal(5,2) [default: 5]
  amount decimal(14,2)
  meter_reading_id bigint [ref: > meter_reading.id]
  item_id bigint [ref: > item.id]
  sales_order_line_id bigint [ref: > sales_order_line.id]
}

Table payment {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  receipt_no varchar(30) [unique, not null]
  tenant_id bigint [ref: > tenant.id, not null]
  payment_date date [not null]
  amount decimal(14,2) [not null]
  currency_id bigint [ref: > currency.id]
  payment_method_id bigint [ref: > lookup_value.id, note: 'cash | bank_transfer | cheque | online | card']
  reference_no varchar(100)
  received_by bigint [ref: > app_user.id]
  status_id bigint [ref: > lookup_value.id]
  journal_entry_id bigint [ref: > journal_entry.id]
  notes text
}

Table payment_allocation {
  id bigint [pk, increment]
  payment_id bigint [ref: > payment.id, not null]
  invoice_id bigint [ref: > invoice.id, not null]
  amount decimal(14,2) [not null]
}

// ---------------------------------------------------------------------
// 14. VENDOR BILLS & PAYMENTS (AP)
// ---------------------------------------------------------------------
Table vendor_bill {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  vendor_id bigint [ref: > vendor.id, not null]
  bill_no varchar(50) [not null, note: 'vendor invoice number']
  bill_date date [not null]
  due_date date
  purchase_order_id bigint [ref: > purchase_order.id]
  source_type varchar(30) [note: 'amc_contract | refill_request | purchase_order | other']
  source_id bigint
  subtotal decimal(14,2)
  vat_amount decimal(14,2) [default: 0]
  total_amount decimal(14,2)
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  status_id bigint [ref: > lookup_value.id]
  journal_entry_id bigint [ref: > journal_entry.id]
  notes text
  indexes { (vendor_id, bill_no) [unique] }
}

Table vendor_bill_item {
  id bigint [pk, increment]
  bill_id bigint [ref: > vendor_bill.id, not null]
  item_type_id bigint [ref: > lookup_value.id]
  description varchar(300)
  quantity decimal(14,3)
  uom varchar(10)
  unit_price decimal(14,4)
  vat_rate decimal(5,2) [default: 5]
  amount decimal(14,2)
  expense_account_id bigint [ref: > account.id]
  item_id bigint [ref: > item.id]
  purchase_order_line_id bigint [ref: > purchase_order_line.id]
}

Table vendor_payment {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  payment_no varchar(30) [unique, not null]
  vendor_id bigint [ref: > vendor.id, not null]
  payment_date date [not null]
  amount decimal(14,2) [not null]
  currency_id bigint [ref: > currency.id]
  payment_method_id bigint [ref: > lookup_value.id]
  reference_no varchar(100)
  paid_by bigint [ref: > app_user.id]
  status_id bigint [ref: > lookup_value.id]
  journal_entry_id bigint [ref: > journal_entry.id]
  notes text
}

Table vendor_payment_allocation {
  id bigint [pk, increment]
  vendor_payment_id bigint [ref: > vendor_payment.id, not null]
  vendor_bill_id bigint [ref: > vendor_bill.id, not null]
  amount decimal(14,2) [not null]
}

// ---------------------------------------------------------------------
// 15. ACCOUNTING (GL)
// ---------------------------------------------------------------------
Table currency {
  id bigint [pk, increment]
  code char(3) [unique, not null, note: 'AED']
  name_en varchar(50)
  name_ar varchar(50)
  symbol varchar(10)
  decimal_places smallint [default: 2]
  is_active boolean [default: true]
}

Table fiscal_period {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  year smallint [not null]
  period_no smallint [not null]
  start_date date [not null]
  end_date date [not null]
  is_closed boolean [default: false]
  indexes { (company_id, year, period_no) [unique] }
}

Table account {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  parent_account_id bigint [ref: > account.id]
  account_type_id bigint [ref: > lookup_value.id, note: 'asset | liability | equity | revenue | expense']
  account_code varchar(20) [not null]
  name_en varchar(200)
  name_ar varchar(200)
  level smallint
  is_group boolean [default: false]
  is_postable boolean [default: true]
  currency_id bigint [ref: > currency.id]
  is_active boolean [default: true]
  indexes { (company_id, account_code) [unique] }
}

Table account_mapping {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id, note: 'null = all branches']
  source_type varchar(50) [not null, note: 'invoice_item | payment | vendor_bill_item | vendor_payment | deposit | vat']
  source_key_id bigint [ref: > lookup_value.id, note: 'fee type / payment method / etc.']
  debit_account_id bigint [ref: > account.id]
  credit_account_id bigint [ref: > account.id]
  is_active boolean [default: true]
}

Table journal_entry {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id, not null]
  journal_no varchar(30) [unique, not null]
  entry_date date [not null]
  fiscal_period_id bigint [ref: > fiscal_period.id, not null]
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  description text
  source_type varchar(50) [note: 'invoice | payment | vendor_bill | vendor_payment | voucher | stock_transaction | manual']
  source_id bigint
  status_id bigint [ref: > lookup_value.id, note: 'draft | posted | reversed']
  posted_at timestamptz
  posted_by bigint [ref: > app_user.id]
  reversed_entry_id bigint [ref: > journal_entry.id]
  Note: 'Rule: SUM(debit) = SUM(credit) per entry before posting. No posting into closed fiscal_period.'
}

Table journal_line {
  id bigint [pk, increment]
  journal_entry_id bigint [ref: > journal_entry.id, not null]
  account_id bigint [ref: > account.id, not null]
  description varchar(300)
  debit decimal(14,2) [default: 0]
  credit decimal(14,2) [default: 0]
  base_debit decimal(14,2) [default: 0, note: 'in company base currency']
  base_credit decimal(14,2) [default: 0]
  building_id bigint [ref: > building.id, note: 'analytic dimension']
  unit_id bigint [ref: > unit.id]
  tenant_id bigint [ref: > tenant.id]
  vendor_id bigint [ref: > vendor.id]
  contract_id bigint [ref: > supply_contract.id]
  party_id bigint [ref: > party.id, note: 'analytic dimension (employee, customer, supplier)']
  asset_id bigint [ref: > asset.id]
}

// ---------------------------------------------------------------------
// 16. DOCUMENTS, AUDIT & NUMBERING
// ---------------------------------------------------------------------
Table document_type {
  id bigint [pk, increment]
  code varchar(50) [unique, not null, note: 'EID | PASSPORT | VISA | LABOUR_CARD | DRIVING_LICENSE | HAZMAT_PERMIT | TRADE_LICENSE | VAT_CERTIFICATE | VEHICLE_REGISTRATION | VEHICLE_INSURANCE | TITLE_DEED | CD_CERTIFICATE | CONTRACT_COPY | WARRANTY | COMPANY_LOGO | COMPANY_LOGO_DARK | COMPANY_STAMP | PHOTO | OTHER']
  name_en varchar(150)
  name_ar varchar(150)
  category_id bigint [ref: > lookup_value.id, note: 'DOCUMENT_CATEGORY: identity | license | vehicle | contract | certificate | branding | photo | other']
  applies_to varchar(200) [note: 'comma list of entity types allowed, e.g. party,asset']
  has_number boolean [default: true]
  has_expiry boolean [default: false]
  allow_multiple boolean [default: false, note: 'false = one current document of this type per entity']
  is_active boolean [default: true]
}

Table reminder_offset {
  id bigint [pk, increment]
  code varchar(10) [unique, not null, note: '1Y | 1M | 1W (add 3M, 1D ... any time)']
  name_en varchar(50) [note: '1 year before']
  name_ar varchar(50)
  offset_value smallint [not null]
  offset_unit varchar(10) [not null, note: 'day | week | month | year']
  sort_order int [default: 0]
  is_active boolean [default: true]
}

Table document_type_reminder {
  document_type_id bigint [ref: > document_type.id]
  reminder_offset_id bigint [ref: > reminder_offset.id]
  indexes { (document_type_id, reminder_offset_id) [pk] }
  Note: 'default reminders copied to document_reminder when a document of this type is created; user can change them per document'
}

Table document {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id]
  document_type_id bigint [ref: > document_type.id, not null]
  entity_type varchar(50) [not null, note: 'party | asset | company | branch | building | unit | tenant | supply_contract | amc_contract | cd_certificate | meter_reading | maintenance_visit | customer_request | voucher | purchase_order | ...']
  entity_id bigint [not null]
  party_id bigint [ref: > party.id, note: 'set when entity_type = party (EID, passport, licence ...) - real FK to the party master']
  asset_id bigint [ref: > asset.id, note: 'set when entity_type = asset (registration, insurance, warranty ...) - real FK to the asset master']
  document_no varchar(60) [note: 'e.g. EID 784-1990-1234567-1']
  title varchar(200)
  issue_date date
  expiry_date date
  issuing_authority varchar(150)
  status_id bigint [ref: > lookup_value.id, note: 'DOCUMENT_STATUS: valid | expiring | expired | renewed | cancelled (daily job)']
  is_current boolean [default: true, note: 'false once renewed']
  renewed_from_id bigint [ref: > document.id, note: 'previous version of the same document']
  remarks text
  indexes {
    (entity_type, entity_id)
    party_id
    asset_id
    expiry_date
  }
  Note: 'ONE table for every attachment in the system. No other table stores file paths. Rule: entity_type=party => party_id = entity_id; entity_type=asset => asset_id = entity_id.'
}

Table document_file {
  id bigint [pk, increment]
  document_id bigint [ref: > document.id, not null]
  file_name varchar(255) [not null]
  file_path varchar(500) [not null, note: 'storage path / URL']
  mime_type varchar(100)
  size_bytes bigint
  page_label varchar(30) [note: 'front | back | page 1 ...']
  sort_order int [default: 0]
}

Table document_reminder {
  id bigint [pk, increment]
  document_id bigint [ref: > document.id, not null]
  reminder_offset_id bigint [ref: > reminder_offset.id, not null]
  remind_on date [not null, note: 'expiry_date - offset; recalculated when expiry_date changes']
  notify_user_id bigint [ref: > app_user.id]
  notify_role_id bigint [ref: > role.id]
  channel varchar(20) [default: 'in_app', note: 'in_app | email | sms']
  is_sent boolean [default: false]
  sent_at timestamptz
  is_dismissed boolean [default: false]
  indexes {
    (document_id, reminder_offset_id) [unique]
    (remind_on, is_sent)
  }
}

Table activity_log {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id]
  building_id bigint [ref: > building.id]
  entity_type varchar(50)
  entity_id bigint
  action varchar(50) [note: 'create | update | delete | status_change | post']
  severity_id bigint [ref: > lookup_value.id]
  description text
  old_values jsonb
  new_values jsonb
  user_id bigint [ref: > app_user.id]
  occurred_at timestamptz [not null]
}

Table number_sequence {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id]
  prefix varchar(10) [not null, note: 'B | GSC | INV | RCP | RFR | SR | AMC | JE | PO | VP | P | EMP | AST | ITM | ST | SC | QT | SO | DN | GRN | MR | PV | RV | JV | DBN | CRN | CR']
  year smallint
  last_value int [default: 0]
  padding smallint [default: 4]
  indexes { (company_id, branch_id, prefix, year) [unique] }
}

// ---------------------------------------------------------------------
// 17. ASSETS (master of everything the company owns)
// ---------------------------------------------------------------------
Table asset {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id, not null]
  asset_no varchar(30) [unique, not null, note: 'AST-YYYY-NNNN']
  item_id bigint [ref: > item.id, note: 'catalogue item this asset is a unit of (Item List <-> Assets)']
  asset_category_id bigint [ref: > lookup_value.id, not null, note: 'ASSET_CATEGORY: vehicle | tank | meter | cylinder | equipment | tool | it | furniture | other']
  name_en varchar(200) [not null]
  name_ar varchar(200)
  serial_no varchar(60)
  brand varchar(60)
  model varchar(60)
  custodian_party_id bigint [ref: > party.id, not null, note: 'who holds it now: company | employee | stock | repository']
  building_id bigint [ref: > building.id, note: 'where it is installed, if in a building']
  vendor_id bigint [ref: > vendor.id, note: 'supplier']
  purchase_order_id bigint [ref: > purchase_order.id]
  vendor_bill_id bigint [ref: > vendor_bill.id]
  purchase_date date
  purchase_cost decimal(14,2)
  currency_id bigint [ref: > currency.id]
  warranty_expiry date
  depreciation_method_id bigint [ref: > lookup_value.id, note: 'straight_line | declining | none']
  useful_life_months smallint
  salvage_value decimal(14,2)
  accumulated_depreciation decimal(14,2) [default: 0, note: 'cache - updated by depreciation run']
  asset_account_id bigint [ref: > account.id]
  status_id bigint [ref: > lookup_value.id, note: 'ASSET_STATUS: in_stock | in_use | under_maintenance | damaged | lost | disposed']
  disposed_at date
  disposal_notes text
  is_active boolean [default: true]
  Note: 'vehicle, tank and meter point here through asset_id. Registration / insurance / warranty files = document with asset_id.'
}

Table asset_custody_history {
  id bigint [pk, increment]
  asset_id bigint [ref: > asset.id, not null]
  from_party_id bigint [ref: > party.id]
  to_party_id bigint [ref: > party.id, not null]
  from_date timestamptz [not null]
  to_date timestamptz [note: 'null = current holder. Partial unique: one open row per asset']
  stock_transaction_line_id bigint [ref: > stock_transaction_line.id, note: 'the movement that caused the hand-over']
  handed_by bigint [ref: > app_user.id]
  remarks text
}

// ---------------------------------------------------------------------
// 18. INVENTORY
// ---------------------------------------------------------------------
Table item {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  item_code varchar(30) [unique, not null, note: 'ITM-NNNNN']
  barcode varchar(60)
  name_en varchar(200) [not null]
  name_ar varchar(200)
  description text
  item_type_id bigint [ref: > lookup_value.id, not null, note: 'ITEM_TYPE: stock | asset | consumable | service']
  item_category_id bigint [ref: > lookup_value.id, note: 'ITEM_CATEGORY: gas | meters | regulators | valves | pipes | cylinders | tools | spare_parts ...']
  uom_id bigint [ref: > lookup_value.id, not null, note: 'UOM: each | m | litre | kg | m3 | box']
  brand varchar(60)
  is_serialized boolean [default: false, note: 'true = every unit is an asset row (meters, tanks, cylinders, vehicles)']
  track_stock boolean [default: true, note: 'false for services']
  asset_category_id bigint [ref: > lookup_value.id, note: 'default category for assets created from this item']
  standard_cost decimal(14,4)
  sale_price decimal(14,4)
  vat_rate decimal(5,2) [default: 5]
  reorder_level decimal(14,3)
  reorder_qty decimal(14,3)
  inventory_account_id bigint [ref: > account.id]
  expense_account_id bigint [ref: > account.id]
  revenue_account_id bigint [ref: > account.id]
  is_active boolean [default: true]
}

Table item_stock {
  id bigint [pk, increment]
  item_id bigint [ref: > item.id, not null]
  location_party_id bigint [ref: > party.id, not null, note: 'stock | repository | employee (van stock / custody)']
  branch_id bigint [ref: > branch.id, not null]
  qty_on_hand decimal(14,3) [not null, default: 0]
  qty_reserved decimal(14,3) [not null, default: 0, note: 'confirmed sales orders / approved material requests']
  avg_cost decimal(14,4) [default: 0]
  last_txn_at timestamptz
  indexes { (item_id, location_party_id) [unique] }
  Note: 'ITEM CURRENT QTY. Cache maintained only by posting stock_transaction; never edited by hand. Available = on_hand - reserved.'
}

Table stock_transaction {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  txn_no varchar(30) [unique, not null, note: 'ST-YYYY-NNNN']
  txn_type_id bigint [ref: > lookup_value.id, not null, note: 'STOCK_TXN_TYPE: opening | receipt | restock | issue | return | transfer_branch | transfer_location | transfer_employee | damage | write_off | adjustment | sale_delivery | consumption']
  txn_date timestamptz [not null]
  from_party_id bigint [ref: > party.id, note: 'source store / employee (null for receipt / opening)']
  to_party_id bigint [ref: > party.id, note: 'target store / employee (null for damage / write_off / consumption)']
  from_branch_id bigint [ref: > branch.id]
  to_branch_id bigint [ref: > branch.id]
  reason_id bigint [ref: > lookup_value.id, note: 'STOCK_REASON: broken | expired | lost | count_difference | customer_return ...']
  source_type varchar(40) [note: 'material_request | purchase_order | delivery_note | stock_count | service_request | customer_request_operation | maintenance_visit']
  source_id bigint
  status_id bigint [ref: > lookup_value.id, note: 'STOCK_TXN_STATUS: draft | pending_approval | approved | posted | cancelled']
  requested_by bigint [ref: > app_user.id]
  approved_by bigint [ref: > app_user.id]
  approved_at timestamptz
  posted_by bigint [ref: > app_user.id]
  posted_at timestamptz
  journal_entry_id bigint [ref: > journal_entry.id, note: 'damage / write-off / adjustment / branch transfer valuation']
  remarks text
  Note: 'ITEM TRANSFER & ITEM TRANSACTIONS. Branch->branch, store->store, restock, employee->employee, damage ... all one table, told apart by txn_type.'
}

Table stock_transaction_line {
  id bigint [pk, increment]
  stock_transaction_id bigint [ref: > stock_transaction.id, not null]
  line_no smallint
  item_id bigint [ref: > item.id, not null]
  asset_id bigint [ref: > asset.id, note: 'serialized items: which unit moved (quantity = 1)']
  quantity decimal(14,3) [not null]
  uom_id bigint [ref: > lookup_value.id]
  unit_cost decimal(14,4)
  amount decimal(14,2)
  material_request_line_id bigint [ref: > material_request_line.id]
  remarks text
}

Table stock_ledger {
  id bigint [pk, increment]
  item_id bigint [ref: > item.id, not null]
  location_party_id bigint [ref: > party.id, not null]
  branch_id bigint [ref: > branch.id, not null]
  stock_transaction_line_id bigint [ref: > stock_transaction_line.id, not null]
  txn_date timestamptz [not null]
  qty_in decimal(14,3) [default: 0]
  qty_out decimal(14,3) [default: 0]
  balance_qty decimal(14,3) [not null]
  unit_cost decimal(14,4)
  value_in decimal(14,2) [default: 0]
  value_out decimal(14,2) [default: 0]
  balance_value decimal(14,2)
  indexes { (item_id, location_party_id, txn_date) }
  Note: 'TRANSACTION HISTORY. Append-only. A transfer writes 2 rows (out of from_party, in to to_party). Corrections = a new reversing transaction.'
}

Table stock_count {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  count_no varchar(30) [unique, not null, note: 'SC-YYYY-NNNN']
  location_party_id bigint [ref: > party.id, not null]
  count_date date [not null]
  counted_by_party_id bigint [ref: > party.id]
  status_id bigint [ref: > lookup_value.id, note: 'draft | counting | submitted | approved | posted']
  adjustment_txn_id bigint [ref: > stock_transaction.id, note: 'adjustment created from the differences']
  remarks text
  Note: 'INVENTORY DETAILS: physical count of a store / employee custody.'
}

Table stock_count_line {
  id bigint [pk, increment]
  stock_count_id bigint [ref: > stock_count.id, not null]
  item_id bigint [ref: > item.id, not null]
  asset_id bigint [ref: > asset.id]
  system_qty decimal(14,3) [not null]
  counted_qty decimal(14,3)
  difference_qty decimal(14,3)
  remarks text
}

// ---------------------------------------------------------------------
// 19. SALES & PURCHASING
// ---------------------------------------------------------------------
Table quotation {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  quotation_no varchar(30) [unique, not null, note: 'QT-YYYY-NNNN']
  customer_party_id bigint [ref: > party.id, not null]
  tenant_id bigint [ref: > tenant.id]
  building_id bigint [ref: > building.id]
  sales_person_party_id bigint [ref: > party.id, note: 'employee']
  quotation_date date [not null]
  valid_until date
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  subtotal decimal(14,2)
  discount_amount decimal(14,2) [default: 0]
  vat_amount decimal(14,2) [default: 0]
  total_amount decimal(14,2)
  status_id bigint [ref: > lookup_value.id, note: 'QUOTATION_STATUS: draft | sent | accepted | rejected | expired | converted']
  terms text
  notes text
}

Table quotation_line {
  id bigint [pk, increment]
  quotation_id bigint [ref: > quotation.id, not null]
  line_no smallint
  item_id bigint [ref: > item.id]
  description varchar(300)
  quantity decimal(14,3) [not null]
  uom_id bigint [ref: > lookup_value.id]
  unit_price decimal(14,4)
  discount_pct decimal(5,2) [default: 0]
  vat_rate decimal(5,2) [default: 5]
  amount decimal(14,2)
}

Table sales_order {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  so_no varchar(30) [unique, not null, note: 'SO-YYYY-NNNN']
  quotation_id bigint [ref: > quotation.id]
  customer_party_id bigint [ref: > party.id, not null]
  tenant_id bigint [ref: > tenant.id]
  building_id bigint [ref: > building.id]
  unit_id bigint [ref: > unit.id]
  sales_person_party_id bigint [ref: > party.id]
  order_date date [not null]
  expected_delivery_date date
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  subtotal decimal(14,2)
  discount_amount decimal(14,2) [default: 0]
  vat_amount decimal(14,2) [default: 0]
  total_amount decimal(14,2)
  status_id bigint [ref: > lookup_value.id, note: 'SO_STATUS: draft | confirmed | partially_delivered | delivered | invoiced | cancelled']
  notes text
}

Table sales_order_line {
  id bigint [pk, increment]
  sales_order_id bigint [ref: > sales_order.id, not null]
  quotation_line_id bigint [ref: > quotation_line.id]
  line_no smallint
  item_id bigint [ref: > item.id]
  description varchar(300)
  quantity decimal(14,3) [not null]
  delivered_qty decimal(14,3) [default: 0]
  invoiced_qty decimal(14,3) [default: 0]
  uom_id bigint [ref: > lookup_value.id]
  unit_price decimal(14,4)
  discount_pct decimal(5,2) [default: 0]
  vat_rate decimal(5,2) [default: 5]
  amount decimal(14,2)
}

Table material_request {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  mr_no varchar(30) [unique, not null, note: 'MR-YYYY-NNNN']
  request_date date [not null]
  required_by_date date
  requested_by_party_id bigint [ref: > party.id, not null, note: 'employee']
  department_id bigint [ref: > lookup_value.id]
  building_id bigint [ref: > building.id]
  service_request_id bigint [ref: > service_request.id]
  deliver_to_party_id bigint [ref: > party.id, note: 'store or employee to receive the items']
  priority_id bigint [ref: > lookup_value.id]
  status_id bigint [ref: > lookup_value.id, note: 'MR_STATUS: draft | pending_approval | approved | rejected | partially_fulfilled | fulfilled | cancelled']
  approved_by bigint [ref: > app_user.id]
  approved_at timestamptz
  notes text
  Note: 'Fulfilled from stock (stock_transaction issue/transfer) or converted to purchase_order.'
}

Table material_request_line {
  id bigint [pk, increment]
  material_request_id bigint [ref: > material_request.id, not null]
  line_no smallint
  item_id bigint [ref: > item.id, not null]
  description varchar(300)
  quantity decimal(14,3) [not null]
  issued_qty decimal(14,3) [default: 0]
  ordered_qty decimal(14,3) [default: 0]
  uom_id bigint [ref: > lookup_value.id]
  remarks text
}

Table purchase_order {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  po_no varchar(30) [unique, not null, note: 'PO-YYYY-NNNN']
  vendor_id bigint [ref: > vendor.id, not null]
  material_request_id bigint [ref: > material_request.id]
  po_date date [not null]
  expected_date date
  deliver_to_party_id bigint [ref: > party.id, note: 'receiving store']
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  subtotal decimal(14,2)
  discount_amount decimal(14,2) [default: 0]
  vat_amount decimal(14,2) [default: 0]
  total_amount decimal(14,2)
  payment_terms varchar(200)
  status_id bigint [ref: > lookup_value.id, note: 'PO_STATUS: draft | pending_approval | approved | sent | partially_received | received | billed | closed | cancelled']
  approved_by bigint [ref: > app_user.id]
  approved_at timestamptz
  notes text
  Note: 'General purchasing. refill_po stays for the gas refill workflow.'
}

Table purchase_order_line {
  id bigint [pk, increment]
  purchase_order_id bigint [ref: > purchase_order.id, not null]
  material_request_line_id bigint [ref: > material_request_line.id]
  line_no smallint
  item_id bigint [ref: > item.id]
  description varchar(300)
  quantity decimal(14,3) [not null]
  received_qty decimal(14,3) [default: 0]
  billed_qty decimal(14,3) [default: 0]
  uom_id bigint [ref: > lookup_value.id]
  unit_price decimal(14,4)
  vat_rate decimal(5,2) [default: 5]
  amount decimal(14,2)
}

Table delivery_note {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  dn_no varchar(30) [unique, not null, note: 'DN-YYYY-NNNN (outbound) / GRN-YYYY-NNNN (inbound)']
  direction_id bigint [ref: > lookup_value.id, not null, note: 'DN_DIRECTION: outbound (to customer) | inbound (goods received from supplier)']
  sales_order_id bigint [ref: > sales_order.id]
  purchase_order_id bigint [ref: > purchase_order.id]
  customer_party_id bigint [ref: > party.id]
  vendor_id bigint [ref: > vendor.id]
  delivery_date timestamptz [not null]
  from_party_id bigint [ref: > party.id, note: 'store (outbound)']
  to_party_id bigint [ref: > party.id, note: 'store (inbound)']
  building_id bigint [ref: > building.id]
  unit_id bigint [ref: > unit.id]
  vehicle_id bigint [ref: > vehicle.id]
  driver_party_id bigint [ref: > party.id]
  received_by_name varchar(150)
  received_by_phone varchar(30)
  status_id bigint [ref: > lookup_value.id, note: 'DN_STATUS: draft | dispatched | delivered | received | cancelled']
  stock_transaction_id bigint [ref: > stock_transaction.id, note: 'stock movement posted from this note']
  notes text
}

Table delivery_note_line {
  id bigint [pk, increment]
  delivery_note_id bigint [ref: > delivery_note.id, not null]
  line_no smallint
  item_id bigint [ref: > item.id, not null]
  asset_id bigint [ref: > asset.id]
  sales_order_line_id bigint [ref: > sales_order_line.id]
  purchase_order_line_id bigint [ref: > purchase_order_line.id]
  quantity decimal(14,3) [not null]
  uom_id bigint [ref: > lookup_value.id]
  remarks text
}

// ---------------------------------------------------------------------
// 20. ACCOUNTING VOUCHERS (DR / CR)
// ---------------------------------------------------------------------
Table voucher {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  branch_id bigint [ref: > branch.id, not null]
  voucher_no varchar(30) [unique, not null, note: 'PV- | RV- | JV- | DBN- | CRN- YYYY-NNNN']
  voucher_type_id bigint [ref: > lookup_value.id, not null, note: 'VOUCHER_TYPE: payment | receipt | journal | debit_note | credit_note | petty_cash']
  voucher_date date [not null]
  party_id bigint [ref: > party.id, note: 'payee / payer']
  cash_bank_account_id bigint [ref: > account.id, note: 'payment / receipt vouchers']
  payment_method_id bigint [ref: > lookup_value.id]
  cheque_no varchar(30)
  cheque_date date
  bank_reference varchar(100)
  currency_id bigint [ref: > currency.id]
  exchange_rate decimal(18,6) [default: 1]
  total_amount decimal(14,2) [not null]
  description text
  source_type varchar(40) [note: 'customer_request | vendor_bill | invoice | manual']
  source_id bigint
  status_id bigint [ref: > lookup_value.id, note: 'VOUCHER_STATUS: draft | pending_approval | approved | posted | cancelled | reversed']
  prepared_by bigint [ref: > app_user.id]
  approved_by bigint [ref: > app_user.id]
  approved_at timestamptz
  posted_by bigint [ref: > app_user.id]
  posted_at timestamptz
  journal_entry_id bigint [ref: > journal_entry.id, note: 'created on posting (source_type = voucher)']
  Note: 'Rule: SUM(debit) = SUM(credit) over voucher_line before approval.'
}

Table voucher_line {
  id bigint [pk, increment]
  voucher_id bigint [ref: > voucher.id, not null]
  line_no smallint
  account_id bigint [ref: > account.id, not null]
  party_id bigint [ref: > party.id]
  description varchar(300)
  debit decimal(14,2) [default: 0]
  credit decimal(14,2) [default: 0]
  building_id bigint [ref: > building.id]
  unit_id bigint [ref: > unit.id]
  tenant_id bigint [ref: > tenant.id]
  vendor_id bigint [ref: > vendor.id]
  contract_id bigint [ref: > supply_contract.id]
  asset_id bigint [ref: > asset.id]
}

// ---------------------------------------------------------------------
// 21. CUSTOMER REQUESTS & APPROVALS
// ---------------------------------------------------------------------
Table customer_request {
  id bigint [pk, increment]
  branch_id bigint [ref: > branch.id, not null]
  request_no varchar(30) [unique, not null, note: 'CR-YYYY-NNNN']
  request_type_id bigint [ref: > lookup_value.id, not null, note: 'CUSTOMER_REQUEST_TYPE: refund | cancellation | deposit_refund | disconnection | reconnection | transfer_ownership | meter_change | billing_dispute | complaint | other']
  customer_party_id bigint [ref: > party.id, not null]
  tenant_id bigint [ref: > tenant.id]
  contract_id bigint [ref: > supply_contract.id]
  building_id bigint [ref: > building.id]
  unit_id bigint [ref: > unit.id]
  meter_id bigint [ref: > meter.id]
  invoice_id bigint [ref: > invoice.id]
  payment_id bigint [ref: > payment.id]
  channel_id bigint [ref: > lookup_value.id, note: 'REQUEST_CHANNEL: walk_in | phone | email | portal | whatsapp']
  reason_id bigint [ref: > lookup_value.id, note: 'REQUEST_REASON']
  request_date timestamptz [not null]
  description text [not null]
  requested_amount decimal(14,2)
  approved_amount decimal(14,2)
  priority_id bigint [ref: > lookup_value.id]
  status_id bigint [ref: > lookup_value.id, not null, note: 'CUSTOMER_REQUEST_STATUS: new | under_review | pending_approval | approved | rejected | in_progress | completed | cancelled | closed']
  current_approval_step smallint
  assigned_to_party_id bigint [ref: > party.id, note: 'employee']
  voucher_id bigint [ref: > voucher.id, note: 'refund payment voucher']
  resolution text
  closed_at timestamptz
  closed_by bigint [ref: > app_user.id]
  Note: 'Status changes are logged in activity_log (action = status_change); approvals in approval_step.'
}

Table customer_request_operation {
  id bigint [pk, increment]
  customer_request_id bigint [ref: > customer_request.id, not null]
  visit_date timestamptz [not null]
  employee_party_id bigint [ref: > party.id, not null, note: 'technician / employee who did the visit']
  meter_id bigint [ref: > meter.id]
  meter_reading decimal(14,3) [note: 'reading taken on the visit']
  meter_reading_id bigint [ref: > meter_reading.id, note: 'if saved as an official reading']
  issue_details text
  remark text
  next_action_id bigint [ref: > lookup_value.id, note: 'NEXT_ACTION: revisit | disconnect | reconnect | replace_meter | refund | escalate | close']
  next_action_note text
  next_action_date date
  status_after_id bigint [ref: > lookup_value.id, note: 'request status after this operation']
}

Table approval_rule {
  id bigint [pk, increment]
  company_id bigint [ref: > company.id, not null]
  entity_type varchar(50) [not null, note: 'customer_request | material_request | purchase_order | voucher | stock_transaction']
  request_type_id bigint [ref: > lookup_value.id, note: 'optional: rule only for this request / voucher / txn type']
  min_amount decimal(14,2)
  max_amount decimal(14,2)
  step_no smallint [not null]
  approver_role_id bigint [ref: > role.id, not null]
  is_active boolean [default: true]
}

Table approval_step {
  id bigint [pk, increment]
  entity_type varchar(50) [not null]
  entity_id bigint [not null]
  step_no smallint [not null]
  approver_role_id bigint [ref: > role.id]
  approver_user_id bigint [ref: > app_user.id]
  decision_id bigint [ref: > lookup_value.id, note: 'APPROVAL_DECISION: pending | approved | rejected | returned']
  decided_by bigint [ref: > app_user.id]
  decided_at timestamptz
  remarks text
  indexes { (entity_type, entity_id, step_no) [unique] }
  Note: 'Generic approvals for customer requests, material requests, POs, vouchers and stock transactions. Steps are generated from approval_rule.'
}
