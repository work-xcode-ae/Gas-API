{
  "ConnectionStrings": {
    "SedraPetrol": "Server=localhost;Database=SedraPetrol;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "SedraPetrol",
    "Audience": "SedraPetrol.Portal",
    "Key": "CHANGE-ME-this-is-a-development-key-of-64-characters-0123456789",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenMaxDays": 30,
    "RefreshReuseGraceSeconds": 30
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "Storage": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeMb": 20
  },
  "Seed": {
    "Enabled": true,
    "DemoData": true,
    "AdminEmail": "admin@sedrapetrol.ae",
    "AdminPassword": "Admin@12345"
  },
  "Billing": {
    "DefaultVatRate": 5,
    "InvoiceDueDays": 30
  },
  "CivilDefense": {
    "GovernmentFeesPerYear": 0,
    "ServiceFeePerYear": 0
  },
  "Swagger": { "Enabled": true },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
